# ─────────────────────────────────────────────────────────────────────────────
# InterviewIQ environment. Copy to .env (or export these) before running.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database ---------------------------------------------------------------
# Leave SPRING_PROFILES_ACTIVE empty to run the zero-setup local profile
# (file-based H2 in MySQL compatibility mode — same SQL dialect as TiDB).
# Set it to "tidb" to talk to a real TiDB Cloud Serverless cluster.
SPRING_PROFILES_ACTIVE=

# TiDB Cloud Serverless connection details (Console → Connect → JDBC)
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<your username, e.g. 2Txxxxxx.root>
TIDB_PASSWORD=<your password>
TIDB_DATABASE=interviewiq
# TiDB Cloud Serverless uses TLS. Keep VERIFY_IDENTITY for the real cluster.
TIDB_SSL_MODE=VERIFY_IDENTITY

# --- AI provider ------------------------------------------------------------
# heuristic          → built-in offline evaluator (default, no key needed)
# openai-compatible  → any OpenAI-compatible /chat/completions endpoint
#                      (OpenAI, Azure, Groq, Together, OpenRouter, Ollama…)
APP_AI_PROVIDER=heuristic
APP_AI_API_KEY=
APP_AI_MODEL=gpt-4o-mini
APP_AI_BASE_URL=https://api.openai.com/v1

# --- Server -----------------------------------------------------------------
SERVER_PORT=8080
# Where the zero-setup local database file lives (local profile only)
LOCAL_DB_PATH=/tmp/interviewiq
# Browser origins allowed to call the API (comma separated). "*" is dev-only.
APP_CORS_ORIGINS=*

# --- Security ---------------------------------------------------------------
# HMAC signing key for JWTs — 32+ characters. Leave empty and a random one is
# generated per boot (fine locally, never in production).
APP_JWT_SECRET=
# Access-token lifetime in minutes.
APP_JWT_TTL_MINUTES=120
# Bootstrap administrator. If APP_ADMIN_PASSWORD is empty a strong password is
# generated and printed once in the boot log.
APP_ADMIN_EMAIL=admin@interviewiq.dev
APP_ADMIN_PASSWORD=

# --- Seeding ----------------------------------------------------------------
# Creates the demo accounts (recruiter@ / student@ / admin@interviewiq.dev),
# the question bank, demo students and the published demo OA (code DEMO26).
APP_SEED=true
# Shared password for the seeded demo accounts (must satisfy the password
# policy). Change it, or set APP_SEED=false to skip the demo data entirely.
APP_DEMO_PASSWORD=Demo!Access2026
